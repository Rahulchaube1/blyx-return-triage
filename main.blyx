use std::cli;
use std::text;
use vendor::return_triage::return_triage;

fn main() {
    let arguments = cli_args();
    if args_len(arguments) > 0 {
        if args_len(arguments) % 2 != 0 {
            stderr_line("Expected event and value pairs");
            process_exit(2);
        }
        let mut live = return_triage_start();
        let mut i = 0;
        while i < args_len(arguments) {
            let input = args_at(arguments, i + 1);
            if !text_is_number(input) {
                stderr_line("Expected a whole numeric event value");
                process_exit(2);
            }
            live = return_triage_step(live, args_at(arguments, i), text_number(input));
            let command = return_triage_command(live);
            println!(command);
            if command == "reject" { process_exit(1); }
            i += 2;
        }
        return;
    }
    let mut state = return_triage_start();
    state = return_triage_step(state, "authorize", 9.0);
    println!(return_triage_command(state));
    state = return_triage_step(state, "receive", 8.0);
    println!(return_triage_command(state));
    state = return_triage_step(state, "receive", 9.0);
    println!(return_triage_command(state));
    state = return_triage_step(state, "grade", 1.0);
    println!(return_triage_command(state));
    state = return_triage_step(state, "complete", 9.0);
    println!(return_triage_command(state));
}
